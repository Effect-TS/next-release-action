{
  "name": "@effect/next-release-action",
  "version": "0.0.0",
  "description": "GitHub Action for managing staged release branches and pull requests",
  "homepage": "https://github.com/Effect-TS/next-release-action#readme",
  "bugs": {
    "url": "https://github.com/Effect-TS/next-release-action/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Effect-TS/next-release-action.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@actions/github": "catalog:",
    "@effect/platform-node": "catalog:",
    "@octokit/types": "catalog:",
    "@types/mdast": "catalog:",
    "effect": "catalog:",
    "remark-parse": "catalog:",
    "simple-git": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  }
}
